# ShhAi configuration — copy to `.env` and fill in.
#
# Every value is read from the process environment; secrets never live in
# the image. `docker compose` reads this file automatically (see
# docker-compose.yml). ShhAi.Config is the source of truth for defaults.
# See docs/configuration.md for the full reference.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Enable the Phoenix HTTP server inside the release. The container image sets
# this for you; it is listed here for non-container `mix release` runs.
PHX_SERVER=true
PORT=4000
# Signs/encrypts cookies and other secrets (required in prod). Generate with:
#   mix phx.gen.secret
SECRET_KEY_BASE=
# Host used for URL generation (behind your TLS-terminating reverse proxy).
PHX_HOST=localhost
# Optional Erlang clustering query (e.g. a Kubernetes DNS name).
DNS_CLUSTER_QUERY=

# ---------------------------------------------------------------------------
# Inbound proxy authentication (required to serve /v1 and /api)
# ---------------------------------------------------------------------------
# Comma-separated bearer keys clients present to ShhAi. Revoke by removal.
# Empty => the proxy refuses every /v1 and /api request (503, fail-closed).
PROXY_API_KEYS=

# ---------------------------------------------------------------------------
# Backends (provider instances). Up to 4 of each type: _1 .. _4.
# An enabled instance requires a non-empty API key (fail-closed config error).
# ---------------------------------------------------------------------------
PROVIDER_OPENAI_1_ENABLED=false
PROVIDER_OPENAI_1_API_KEY=
PROVIDER_OPENAI_1_BASE_URL=https://api.openai.com/v1
PROVIDER_OPENAI_1_TIMEOUT=60000
PROVIDER_OPENAI_1_NAME=

PROVIDER_ANTHROPIC_1_ENABLED=false
PROVIDER_ANTHROPIC_1_API_KEY=
PROVIDER_ANTHROPIC_1_BASE_URL=https://api.anthropic.com
PROVIDER_ANTHROPIC_1_TIMEOUT=60000
PROVIDER_ANTHROPIC_1_NAME=

PROVIDER_OLLAMA_1_ENABLED=false
PROVIDER_OLLAMA_1_API_KEY=
PROVIDER_OLLAMA_1_BASE_URL=http://localhost:11434
PROVIDER_OLLAMA_1_TIMEOUT=120000
PROVIDER_OLLAMA_1_NAME=

# How often the model catalog probes the enabled providers (ms).
MODEL_CATALOG_REFRESH_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# PII detection
# ---------------------------------------------------------------------------
PII_ENABLED=true
# Comma-separated subset of: name,location,email,phone,ssn,financial,...
PII_TYPES=
PII_REGEX_CONFIDENCE_THRESHOLD=0.7
PII_PRESERVE_IN_SYSTEM=
PII_ALWAYS_SANITIZE=
# NER (neural) detection. On by default in the full image; the slim image has
# no ML stack, so it defaults off and serves regex-only.
PII_NER_ENABLED=
PII_NER_CONFIDENCE_THRESHOLD=0.60
PII_NER_TEMPERATURE=1.0
# Per-type NER floors overriding the global threshold, e.g. title:0.4,date:0.5
PII_NER_TYPE_THRESHOLDS=
PII_HYBRID_MODE=complementary
# :block (fail closed, default) or "forward" (fail open on detector errors).
PII_ERROR_MODE=block

# ---------------------------------------------------------------------------
# Offline NER model (baked into the full image; air-gapped at runtime)
# ---------------------------------------------------------------------------
# The image sets these: the model is baked into BUMBLEBEE_CACHE_DIR at build
# time and loaded with BUMBLEBEE_OFFLINE=true so no network fetch happens.
BUMBLEBEE_OFFLINE=true
BUMBLEBEE_CACHE_DIR=/models

# ---------------------------------------------------------------------------
# Audit Mode (persisted, encrypted PII store). Off by default.
# ---------------------------------------------------------------------------
AUDIT_MODE=false
# Base32-encoded 32-byte key; REQUIRED when AUDIT_MODE=true (fail-closed).
# Generate with: mix run -e 'IO.puts(:crypto.strong_rand_bytes(32) |> Base.encode32())'
AUDIT_ENCRYPTION_KEY=
# SQLite path — point at a mounted volume so the DB survives the container.
AUDIT_DB_PATH=/data/audit.db
AUDIT_RETENTION_DAYS=30
AUDIT_CLEANUP_INTERVAL_HOURS=1

# ---------------------------------------------------------------------------
# Admin dashboard (single operator credential; 403 when unset)
# ---------------------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Conversation store
# ---------------------------------------------------------------------------
# "ets" (default) or "redis".
CONVERSATION_STORE_BACKEND=ets
CONVERSATION_TTL=3600
REDIS_URL=

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------
METRICS_BUFFER_SIZE=1000
