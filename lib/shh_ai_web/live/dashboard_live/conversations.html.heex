<Layouts.admin flash={@flash} view={:conversations} audit_mode={@audit_mode}>
  <div class="space-y-4">
    <div class="mb-5">
      <h1 class="text-base font-semibold text-base-content tracking-tight">
        Conversations
      </h1>
      <p class="text-xs text-base-content/50 mt-1">
        <%= if @audit_off do %>
          Audit Mode off — conversation history is not recorded
        <% else %>
          {@stat_counts[:conversations_today] || 0} conversations today · {@stat_counts[
            :pii_detected
          ] || 0} PII detected
        <% end %>
      </p>
    </div>

    <div
      :if={@audit_off}
      id="audit-off-empty-state"
      class="flex flex-col items-center justify-center py-16 text-center"
    >
      <div class="grid size-11 place-items-center rounded-full bg-base-200 mb-3">
        <span class="hero-eye-slash h-5 w-5 opacity-50"></span>
      </div>
      <p class="text-sm font-medium">Audit Mode is off</p>
      <p class="text-xs text-base-content/50 mt-1 max-w-md">
        Conversation history is not recorded in this deployment. Set
        <code class="font-mono">AUDIT_MODE=true</code>
        and restart ShhAi to record and review conversations.
      </p>
    </div>

    <div :if={!@audit_off} class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <Components.stat_card_clickable
        title="Conversations today"
        value={@stat_counts[:conversations_today] || 0}
        icon="hero-chat-bubble-left"
        subtext={@stat_counts[:conversations_subtext]}
        active={@active_stat_filter == "conversations"}
        filter="conversations"
      />

      <Components.stat_card_clickable
        title="PII detected"
        value={@stat_counts[:pii_detected] || 0}
        icon="hero-shield-check"
        subtext={@stat_counts[:pii_subtext]}
        active={@active_stat_filter == "pii"}
        filter="pii"
        value_class="text-primary"
      />

      <Components.stat_card_clickable
        title="Opt-outs handled"
        value={@stat_counts[:optouts_handled] || 0}
        icon="hero-no-symbol"
        subtext={@stat_counts[:optouts_handled_subtext]}
        active={@active_stat_filter == "optouts"}
        filter="optouts"
      />
      <Components.stat_card_clickable
        title="Opt-outs not honored"
        value={@stat_counts[:optouts_not_honored] || 0}
        icon="hero-check-circle"
        subtext={@stat_counts[:optouts_not_honored_subtext]}
        active={@active_stat_filter == "optout-not-honored"}
        filter="optout-not-honored"
      />
    </div>

    <%= if !@audit_off do %>
      <Components.filter_bar
        filters={
          %{provider: @filters.provider, has_pii: @filters.has_pii, opted_out: @filters.opted_out}
        }
        time_window={@time_window}
        on_filter="filter"
        on_time_window="set-time-window"
      />

      <div class="flex flex-col gap-2">
        <%= for card <- @cards do %>
          <Components.conversation_card
            :if={card.type == :normal}
            id={card.id}
            preview={card.preview}
            source_provider={card.source_provider}
            total_pii={card.total_pii}
            turn_count={card.turn_count}
            last_active_at_us={card.last_active_at_us}
          />
          <Components.conversation_card_tombstoned
            :if={card.type == :tombstoned}
            id={card.id}
            source_provider={card.source_provider}
            request_count={card.request_count}
            pii_type_count={card.pii_type_count}
            pii_types={card.pii_types}
            total_pii={card.total_pii}
            last_active_at_us={card.last_active_at_us}
          />
        <% end %>
      </div>
    <% end %>

    <Components.slideover slideover={@slideover} />
  </div>
</Layouts.admin>
